# Delta Exchange India API
# Dashboard → API management → create key with trading permission
DELTA_API_KEY=
DELTA_API_SECRET=

# Production India (default) / Testnet: https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# true = log orders only (safe default). Set false for live trading.
DRY_RUN=true

# Per-symbol contract size
# BTC: 1 lot; shorts at nearest 200 ATM; CE buy +1000 / PE buy -1000
BTC_LOT_SIZE=1
ETH_LOT_SIZE=1
XAUT_LOT_SIZE=1

# Per-symbol day-N PnL ladder base (USD credit * contracts)
BTC_DAY_PNL_BASE=15
ETH_DAY_PNL_BASE=8
XAUT_DAY_PNL_BASE=5

# Legacy fallback (unused if per-symbol bases set)
DAY_PNL_BASE_USD=15

WEBHOOK_PORT=9000
