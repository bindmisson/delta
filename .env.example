# Delta Exchange India API
# Dashboard → API management → create key with trading permission
DELTA_API_KEY=
DELTA_API_SECRET=

# Production India (default) / Testnet: https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# true = log orders only (safe default). Set false for live trading.
DRY_RUN=true

# Contract size per iron-condor leg
BTC_LOT_SIZE=1
ETH_LOT_SIZE=1

# Day-N PnL target ladder base (USD credit * contracts)
DAY_PNL_BASE_USD=15

WEBHOOK_PORT=9000
